# ==============================================================================
# Frontier AI — Environment Configuration
# ==============================================================================

NODE_ENV=development
PORT=3030
BASE_URL=http://localhost:3030

# Host Configuration (Designate yourself as the Team Host & Lead)
HOST_NAME=Your Name
HOST_EMAIL=your.email@gmail.com
HOST_HANDLE=yourhandle
HOST_GITHUB_ID=12345678

# Secret key used for HMAC signing of blind anonymous voting tokens (minimum 32 bytes hex)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTING_SECRET=generate_a_random_64_character_hex_secret_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI Copilot (Groq API Key)
GROQ_API_KEY=gsk_your_groq_api_key_here
