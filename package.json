{
  "name": "frontier-ai-platform",
  "version": "1.0.0",
  "description": "Frontier AI Internal Platform - Working Prototype with Blind Anonymous Voting, Task Tracking, and 2-Man Governance",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server.js",
    "dev:client": "vite",
    "dev:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "vite build",
    "test": "node test_prototype.js"
  },
  "keywords": [
    "frontier-ai",
    "zero-cost",
    "anonymous-voting",
    "two-man-rule",
    "governance"
  ],
  "author": "Frontier AI Engineering Team",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
